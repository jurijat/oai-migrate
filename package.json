{
  "name": "openapis-org",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "migrate": "node tools/migrate/run.mjs",
    "migrate:fetch": "node tools/migrate/fetch.mjs",
    "migrate:convert": "node tools/migrate/convert.mjs",
    "migrate:assets": "node tools/migrate/assets.mjs",
    "migrate:report": "node tools/migrate/report.mjs",
    "validate": "node tools/validate.mjs",
    "assets": "node tools/publish-assets.mjs",
    "predev": "npm run brand && npm run assets && npm run search:index",
    "prebuild": "npm run brand && npm run assets && npm run search:index",
    "migrate:publish": "node tools/publish-assets.mjs",
    "migrate:redirects": "node tools/migrate/redirects.mjs",
    "postbuild": "node tools/postbuild.mjs",
    "check:basepath": "node tools/check-basepath.mjs",
    "migrate:structured": "node tools/migrate/extract-structured.mjs",
    "check:parity": "node tools/check-parity.mjs",
    "check:render": "node tools/check-render.mjs",
    "search:index": "node tools/build-search-index.mjs",
    "brand": "node tools/publish-brand.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.1",
    "next": "^16.3.0",
    "next-mdx-remote": "^6.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^3.24.1"
