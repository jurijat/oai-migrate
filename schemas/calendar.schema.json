{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Community calendar",
  "description": "Generated by tools/sync-calendar.mjs from LFX Meetings. Do not edit by hand.",
  "type": "object",
  "additionalProperties": false,
  "required": ["source", "window", "project", "meetings", "occurrences"],
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "name"],
      "properties": {
        "slug": { "$ref": "#/$defs/slug" },
        "name": { "type": "string", "minLength": 1 }
      }
    }
  },
  "properties": {
    "source": { "type": "string", "format": "uri" },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "until"],
      "properties": {
        "from": { "type": "string", "format": "date" },
        "until": { "type": "string", "format": "date" }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "slug", "name", "subprojects"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9]+$" },
        "slug": { "$ref": "#/$defs/slug" },
        "name": { "type": "string", "minLength": 1 },
        "subprojects": { "type": "array", "items": { "$ref": "#/$defs/project" } }
      }
    },
    "meetings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "project", "url", "recurrence"],
        "properties": {
          "id": { "type": "string", "pattern": "^\\d+$" },
          "title": { "type": "string", "minLength": 1 },
          "project": { "$ref": "#/$defs/slug" },
          "url": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^https://zoom-lfx\\.platform\\.linuxfoundation\\.org/"
              },
              { "type": "null" }
            ]
          },
          "recurrence": { "type": ["string", "null"] }
        }
      }
    },
    "occurrences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["meeting", "start", "end", "participants"],
        "properties": {
          "meeting": { "type": "string", "pattern": "^\\d+$" },
          "start": { "type": "string", "format": "date-time" },
          "end": { "type": "string", "format": "date-time" },
          "participants": { "type": ["integer", "null"], "minimum": 0 }
        }
      }
    }
  }
}
